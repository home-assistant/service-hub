{
  "name": "ha-github-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "nest start -b swc --watch",
    "build": "nest build -b swc",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "capture": "node scripts/capture-webhooks.ts",
    "scrub": "node scripts/capture-webhooks.ts scrub",
    "capture-discord": "pnpm build && node scripts/capture-discord.ts",
    "sync-templates": "node scripts/sync-templates.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1090.0",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks-methods": "^6.0.0",
    "@octokit/webhooks-types": "^7.6.1",
    "@sentry/nestjs": "^10.70.0",
    "discord.js": "^14.26.5",
    "mustache": "^4.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.29",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.6",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "chokidar": "^5.0.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  }
}
